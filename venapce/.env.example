# Venapce configuration. install.sh writes this for you (generating real secrets
# and filling in the FloMorphic bits); the values here are the standalone
# defaults. Copy to .env to edit by hand.

# The published image to run.
VENAPCE_IMAGE=mehdishokohi/venapce:latest

# Hostname this instance is reached at (self-signed cert SAN for Superset's TLS).
PUBLIC_HOST=localhost

# Host ports to publish.
VENAPCE_PORT=8080      # the panel (wapp + /api), via nginx
SUPERSET_PORT=8090     # Superset's own UI (direct/admin); 8088 is FloMorphic's canvas

# ── Superset ─────────────────────────────────────────────────────────────────
# REQUIRED in production — a real random key. install.sh generates one.
#   openssl rand -base64 42
SUPERSET_SECRET_KEY=CHANGE_ME_super_insecure_default_key
ADMIN_USER=admin
ADMIN_PASS=admin
ADMIN_EMAIL=admin@venapce.local
# Load Superset's example datasets on first boot (needs internet).
LOAD_EXAMPLES=false

# ── Venapce backend ──────────────────────────────────────────────────────────
# Keys the encryption of stored secrets — set a real random value in production.
VENAPCE_APP_SECRET=dev-insecure-change-me
# Password for the internal `venapce` Postgres role.
VENAPCE_DB_PASS=venapce

# ── FloMorphic (Venapce runs as a FloMorphic plugin) ─────────────────────────
# The FloMorphic API base as reached over inflow_net, and the shared secret
# (FloMorphic's API_JWT_SECRET / INFLOW_INFRA_JWT_SECRET). install.sh captures
# these from the FloMorphic instance it finds or installs.
FLOMORPHIC_URL=http://flomorphic:8025
FLOMORPHIC_JWT_SECRET=
# Infra host for NATS (:4222) + osspace (:8022) — the Infra container name on
# inflow_net.
INFRA_HOST=inflow-infra
